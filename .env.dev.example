# Local settings for `make dev`: copy to .env.dev (gitignored) and fill in.

# All bundled routes instead of Rolling Hills alone.
OPENRADLR_ROUTES_DIR=../routes

# --- Strava, as in production -------------------------------------------------
# Left empty here, `make dev` takes the two Strava keys from .env (only those).
# Your Strava API app (https://www.strava.com/settings/api) works locally as is:
# Strava always accepts localhost and 127.0.0.1 as callback domains.
# Open the app at exactly this address (it also guards the WebSocket).
OPENRADLR_PUBLIC_URL=http://localhost:8080
OPENRADLR_STRAVA_CLIENT_ID=
OPENRADLR_STRAVA_CLIENT_SECRET=
# Optional: stay connected across restarts (`openssl rand -hex 32`).
OPENRADLR_SECRET_KEY=
# true: try the "Strava required" flow.
OPENRADLR_REQUIRE_STRAVA=false

# --- A bike on the server's Bluetooth ------------------------------------------
# The bike the server itself connects to (needs the `bike` cargo feature,
# BlueZ and libdbus): currently `yesoul` (the S3). Empty: none.
OPENRADLR_BIKE=
# Let riders connect their own devices in the browser? With a bike offered the
# standard is no (its clients ride the server bike); =on brings the full
# chooser back for a household that mixes both.
OPENRADLR_CLIENT_DEVICES=
